# ============================================================
# A股量化投资系统 - 配置模板
# 复制此文件为 .env 并填入你的配置
# cp .env.example .env
# ============================================================

# MySQL 数据库
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here
MYSQL_DATABASE=quant

# Tushare Token（注册获取: https://tushare.pro/register）
TUSHARE_TOKEN=

# 掘金量化模拟盘（注册获取: https://www.myquant.cn/）
GM_TOKEN=
GM_STRATEGY_ID=

# 数据参数
DATA_START_DATE=20150101
REQUEST_INTERVAL=0.3
DOWNLOAD_WORKERS=8

# Twitter/X 登录凭证（twikit 免费方案，使用普通账号）
TWITTER_USERNAME=
TWITTER_EMAIL=
TWITTER_PASSWORD=

# LLM API（舆情分析增强层，可选）
# provider: anthropic（默认）或 openai（兼容 DeepSeek/通义千问等）
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001
# 以下仅 openai provider 使用
# LLM_API_BASE=https://api.openai.com/v1

# 美股数据（FMP + FRED）
FMP_API_KEY=
FRED_API_KEY=
US_DATA_START_DATE=20150101
# FMP_RATE_LIMIT=300  # 免费版 300 req/min

# Alpaca Markets 模拟盘/实盘（注册获取: https://app.alpaca.markets/）
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# 日志级别
LOG_LEVEL=INFO
